# Copie para .env e ajuste.
# Porta publicada no host. No servidor use 127.0.0.1:8000 para expor so via Caddy.
SDIZIMO_WEB_PORT=8000
SDIZIMO_DB_PORT=5432
# 1 = modo desenvolvimento (DEBUG). Em producao deixe 0.
DJANGO_DEBUG=0
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
