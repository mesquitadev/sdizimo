# Copie para .env e ajuste.

# Porta publicada no host. No servidor use 127.0.0.1:8000 para expor so via proxy.
SDIZIMO_WEB_PORT=8000

# 1 = modo desenvolvimento (DEBUG). Em producao deixe 0.
DJANGO_DEBUG=0

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Assina as sessoes: quem tiver esta chave forja login de qualquer usuario.
DJANGO_SECRET_KEY=

# Banco. Vazio usa os padroes do settings.py, que reproduzem a configuracao
# antiga (sdizimo/sdizimo/sdizimo em 127.0.0.1:5432).
#
# Este projeto nao tem mais um Postgres proprio: usa o compartilhado do
# servidor, alcancado pelo nome do container na rede docker.
DB_HOST=homelab-postgres
DB_NAME=sdizimo
DB_USER=sdizimo
DB_PASSWORD=
DB_PORT=5432
